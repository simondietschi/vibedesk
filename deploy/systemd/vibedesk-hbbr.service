[Unit]
Description=VibeDesk Relay-Server (hbbr)
Documentation=https://github.com/simondietschi/vibedesk
After=network-online.target
Wants=network-online.target

[Service]
User=vibedesk
Group=vibedesk
WorkingDirectory=/var/lib/vibedesk
ExecStart=/usr/local/bin/hbbr
Restart=on-failure
LimitNOFILE=1000000

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/vibedesk

[Install]
WantedBy=multi-user.target
