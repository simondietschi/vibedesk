[Unit]
Description=VibeDesk ID-/Rendezvous-Server (hbbs)
Documentation=https://github.com/simondietschi/vibedesk
After=network-online.target vibedesk-hbbr.service
Wants=network-online.target

[Service]
User=vibedesk
Group=vibedesk
WorkingDirectory=/var/lib/vibedesk
# Zugriffsregeln der Konsole beim Verbindungsaufbau durchsetzen
Environment=VIBEDESK_CONSOLE_DB=/var/lib/vibedesk/console.sqlite3
ExecStart=/usr/local/bin/hbbs
Restart=on-failure
LimitNOFILE=1000000

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/vibedesk

[Install]
WantedBy=multi-user.target
