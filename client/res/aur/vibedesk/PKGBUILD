# Maintainer: Simon Dietschi <E-MAIL>

pkgname=vibedesk
pkgver=1.5.1
_tag="v${pkgver}"
pkgrel=1
pkgdesc="Remote desktop client based on RustDesk, for self-hosted servers"
arch=('x86_64')
url="https://github.com/simondietschi/vibedesk"
license=('AGPL-3.0-only')
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libpulse'
         'libappindicator-gtk3' 'gstreamer' 'gst-plugins-base' 'gst-plugin-pipewire'
         'libvpx' 'aom' 'libyuv' 'opus')
makedepends=('rustup' 'clang' 'cmake' 'ninja' 'git' 'nasm' 'pkgconf' 'unzip' 'xz'
             'which' 'python' 'patchelf')
conflicts=("${pkgname}-bin")
options=('!lto' '!debug')
install="${pkgname}.install"
# Versions the client is built and tested with, see .github/workflows/vibedesk-build.yml.
# The source tarball already contains the flutter_rust_bridge code generated by that workflow.
_rust=1.75.0
_flutter=3.24.5
source=("${url}/releases/download/${_tag}/${pkgname}-${pkgver}-src.tar.gz"
        "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${_flutter}-stable.tar.xz")
sha256sums=('SKIP'
            'a7c82f551a9eae018e078f6bb186171e5a77920d35a3d75a61d9a593d0a9e4ae')

_env() {
  export RUSTUP_TOOLCHAIN="${_rust}"
  export CARGO_HOME="${srcdir}/cargo-home"
  export PUB_CACHE="${srcdir}/pub-cache"
  export PATH="${srcdir}/flutter/bin:${PATH}"
  # Arch ships libyuv without a pkg-config file on some versions.
  export PKG_CONFIG_PATH="${srcdir}/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
}

prepare() {
  _env
  rustup toolchain install "${_rust}" --profile minimal

  if ! pkg-config --exists libyuv; then
    mkdir -p "${srcdir}/pkgconfig"
    printf '%s\n' 'prefix=/usr' 'libdir=${prefix}/lib' 'includedir=${prefix}/include' \
      'Name: libyuv' 'Description: YUV conversion library' 'Version: 0' \
      'Libs: -L${libdir} -lyuv' 'Cflags: -I${includedir}' > "${srcdir}/pkgconfig/libyuv.pc"
  fi

  patch -Np1 -d "${srcdir}/flutter" \
    -i "${srcdir}/${pkgname}-${pkgver}/client/.github/patches/flutter_3.24.4_dropdown_menu_enableFilter.diff"
  flutter config --no-analytics >/dev/null
  flutter precache --linux --no-android --no-ios --no-web --no-macos --no-windows --no-fuchsia

  cd "${pkgname}-${pkgver}/client"
  sed -i 's/\["cdylib", "staticlib", "rlib"\]/["cdylib"]/' Cargo.toml
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
  (cd flutter && flutter pub get)
}

build() {
  _env
  export CARGO_NET_OFFLINE=true
  # libwebm in webm-sys relies on <cstdint> being pulled in implicitly, which GCC 15 no longer does.
  export CXXFLAGS="${CXXFLAGS} -include cstdint"
  cd "${pkgname}-${pkgver}/client"

  # Set VIBEDESK_RENDEZVOUS_SERVER, VIBEDESK_RS_PUB_KEY and VIBEDESK_API_SERVER
  # in the environment to build in your own server.
  cargo build --frozen --release --lib --features flutter,unix-file-copy-paste,linux-pkg-config

  (cd flutter && flutter build linux --release)
}

package() {
  cd "${pkgname}-${pkgver}/client"

  install -d "${pkgdir}/usr/lib/${pkgname}"
  cp -r flutter/build/linux/x64/release/bundle/* "${pkgdir}/usr/lib/${pkgname}/"
  # Flutter plugins keep a RUNPATH into the build directory.
  for f in "${pkgdir}/usr/lib/${pkgname}"/lib/*.so; do
    if [ -n "$(patchelf --print-rpath "$f")" ]; then
      patchelf --set-rpath '$ORIGIN' "$f"
    fi
  done

  install -d "${pkgdir}/usr/bin"
  ln -s "/usr/lib/${pkgname}/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"

  install -Dm644 "res/${pkgname}.service" "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
  sed -i 's|^ExecStop=pkill|ExecStop=/usr/bin/pkill|' "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"

  install -Dm644 "res/${pkgname}.desktop" -t "${pkgdir}/usr/share/applications"
  install -Dm644 "res/${pkgname}-link.desktop" -t "${pkgdir}/usr/share/applications"
  install -Dm644 "res/128x128@2x.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
  install -Dm644 "res/scalable.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"
}
