# Maintainer: Simon Dietschi <E-MAIL>

pkgname=vibedesk-bin
_pkgname=vibedesk
pkgver=1.5.1
_tag="v${pkgver}"
pkgrel=1
pkgdesc="Remote desktop client based on RustDesk, for self-hosted servers"
arch=('x86_64')
url="https://github.com/simondietschi/vibedesk"
license=('AGPL-3.0-only')
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libpulse'
         'libappindicator-gtk3' 'gst-plugins-base' 'gst-plugin-pipewire')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
makedepends=('patchelf')
options=('!strip' '!debug')
install="${pkgname}.install"
source=("${url}/releases/download/${_tag}/${_pkgname}-${pkgver}-x86_64.deb")
# The build workflow replaces @DEB_SHA256@ with the checksum of the release deb.
sha256sums=('@DEB_SHA256@')

package() {
  bsdtar --no-same-owner -xf data.tar.* -C "${pkgdir}"

  # Arch keeps program files in /usr/lib; the deb puts them in /usr/share.
  install -d "${pkgdir}/usr/lib"
  mv "${pkgdir}/usr/share/${_pkgname}" "${pkgdir}/usr/lib/${_pkgname}"
  # Flutter plugins keep a RUNPATH into the build directory.
  for f in "${pkgdir}/usr/lib/${_pkgname}"/lib/*.so; do
    if [ -n "$(patchelf --print-rpath "$f")" ]; then
      patchelf --set-rpath '$ORIGIN' "$f"
    fi
  done

  install -d "${pkgdir}/usr/bin"
  ln -sf "/usr/lib/${_pkgname}/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

  install -Dm644 "${pkgdir}/usr/lib/${_pkgname}/files/systemd/${_pkgname}.service" \
    "${pkgdir}/usr/lib/systemd/system/${_pkgname}.service"
  sed -i 's|^ExecStop=pkill|ExecStop=/usr/bin/pkill|' \
    "${pkgdir}/usr/lib/systemd/system/${_pkgname}.service"
}
