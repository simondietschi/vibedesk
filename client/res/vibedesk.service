[Unit]
Description=VibeDesk
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/vibedesk --service
# kill --tray and --server both
ExecStop=pkill -f "vibedesk --"
# below two lines do not work, have to use above one line
#ExecStop=pkill -f "vibedesk --tray"
#ExecStop=pkill -f "vibedesk --server"
PIDFile=/run/vibedesk.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
