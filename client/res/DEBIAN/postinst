#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/vibedesk/vibedesk /usr/bin/vibedesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/vibedesk.service ]; then
			rm -f /etc/systemd/system/vibedesk.service /usr/lib/systemd/system/vibedesk.service /usr/lib/systemd/user/vibedesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/vibedesk/files/systemd/vibedesk.service /usr/lib/systemd/system/vibedesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload vibedesk.service: Unit vibedesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/vibedesk.service:10: Executable path is not absolute: pkill -f "vibedesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/vibedesk.service
		fi
		systemctl daemon-reload
		systemctl enable vibedesk
		systemctl start vibedesk
	fi
fi
